{
    "name": "ujikom/gudang-atk-laravel",
    "type": "project",
    "description": "Aplikasi Persediaan Barang ATK berbasis Laravel dan MySQL untuk UJIKOM.",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
